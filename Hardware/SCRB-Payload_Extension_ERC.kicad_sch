	(text "First order differential, common-mode RC filter:\n\nf_cMAX = f_MOD/10 = 256kHz/10 = 25.6kHz\nLoad cell specs: R_in = 405 | R_out = 350 | Excitation = 5V\n\nR_F1 <= 1k -> R_F1,2 = 470\nC_DIF1 = 1/(2π * (350+470+470) * 25.6kHz) = 4.82nF -> 5.1nF\nC_CM1,2 = C_DIF1/10 = 510Pf\n\nf_diff = 1/(2π * (350+470+470) * C_DIF1) = 24.2kHz\nC_DIF2 = 1/(2π * 405 * 24.2kHz) = 16.24nF -> 16nF\nf_ref = 1/(2π * 405 * 16nF) = 24.6kHz\n\nC_DIF2 = 1/(2π * 940 * 24.2kHz) = 6.99nF -> 6.8nF\nf_ref = 1/(2π * 940 * 6.8nF) = 24.9kHz"
		(exclude_from_sim no)
		(at 304.292 158.75 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "d6db1996-7c9a-46d0-80de-0a4b401c94a7")
	)
